flowchart TD
  Entry1["scaffold_* MCP tools — agents/boilerplats/mcp-server.js, PREFERRED"] -->|"1a."| Parse
  Entry2["node ~/.agents/boilerplats/scaffold.js --json — fallback"] -->|"1b."| Parse["scaffold.js parseArgs and loadData"]

  Parse -->|"2."| Validate["lib/core.js validateData — kind, language, required fields"]
  Validate -->|"3. resolve template and its marker"| Meta["lib/template-meta.js markerFor, listLanguages, listTemplates"]
  Meta --> Tpl["boilerplats/LANG/*.hbs — csharp, go, javascript, typescript, python, and sh which has only function, helper, member, script, validator"]
  Tpl -->|"4."| Render["core.js render"]

  Render --> Mode{"what is --out"}
  Mode -->|"5a. new file"| Create["scaffoldCreate — writes the file including a scaffold:inject marker"]
  Mode -->|"5b. existing file that already has the marker"| Inject["scaffoldInject — inserts the new member ABOVE the marker"]
  Mode -->|"5c. existing unmarked legacy file"| Adopt["scaffoldAdopt — adopts it automatically, places the marker first"]

  Adopt -->|"6. where does the marker belong"| Anchor["lib/anchor.js resolveAnchor and findAnchor"]
  Anchor --> Lang["braceAnchor for C-like languages, pythonAnchor, shAnchor"]
  Lang --> Inject

  Create --> Out
  Inject -->|"7. every mode returns"| Out["numberedLines plus scanFillable — the full numbered content and the fillable line numbers, so NEVER re-read a file you just scaffolded"]
  Out -->|"8. fill business logic above the marker, never delete the marker"| Done["ordinary Edit calls, then run the tests"]

  Guard["claude/hooks/boilerplate-guard.sh"] -.->|"blocks the hand-written path and points here"| Entry1
  Hint["claude/hooks/boilerplate-hint.sh"] -.->|"suggests this before you start"| Entry1
