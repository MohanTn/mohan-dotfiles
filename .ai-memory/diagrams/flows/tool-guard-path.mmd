flowchart TD
  Call["Model calls any tool"] -->|"1. PreToolUse matcher *"| Always

  subgraph Always["runs for EVERY tool call, before the specific guards"]
    Secret["secret-guard.sh — gates WHAT is read or leaked, credential files"]
    Goal["pre-tool-use-goal-capture.sh — scrapes the GOAL line into state_dir/goal.txt, scanning only assistant text after the last user message"]
    Loop["pre-tool-use-loop-breaker.sh — trips on CONSECUTIVE identical calls, not cumulative"]
  end

  Always -->|"2."| Which{"which tool"}

  Which -->|"Edit or Write"| BP["boilerplate-guard.sh — rename-proof, matches filename AND content signature against the boilerplats kinds"]
  BP -->|"3a. boilerplate shaped"| Blocked["BLOCKED — go generate it instead, flows/scaffold-a-file.mmd"]
  BP -->|"3b. clean"| NoOp["pre-tool-use-edit-guard.sh — no-op guard, rejects an edit that changes nothing"]
  NoOp -->|"4. edit lands"| Post["PostToolUse — post-tool-use-edit.sh sets the dirty flag and checks symbol existence, deliberately no full project compile"]

  Which -->|"Bash"| Allow["bash-allowlist-guard.sh — allowlist-only, checks EVERY command position including pipeline stages, chained segments, command substitutions and subshells"]
  Allow -->|"5a. unlisted binary or shell keyword"| BlockedSh["BLOCKED — use the Read, Edit, Write and search tools, or add the binary to ~/.claude/bash-allowlist or .claude/bash-allowlist"]
  Allow -->|"5b. allowed"| WriteG["bash-write-guard.sh — closes the shell write-around, heredoc redirects, tee, sed -i"]
  WriteG -->|"6a. writes a boilerplate file through the shell"| Blocked
  WriteG -->|"6b. clean"| Run["command runs"]
